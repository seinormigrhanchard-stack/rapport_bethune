@

% La production d'anguilles argentées en amont de Poses est estimée, à partir du modèle EDA, à environ 24 000 individus, 5 500 à l'amont de Pontoise et 2 000 à l'amont de Carandeau \citep{briand_eel_2022}. Ces valeurs permettent d’estimer la production générale du bassin, mais le nombre d’individus effectivement contrôlés sur les stations n’est pas représentatif de cette production réelle : seule une fraction des anguilles dévalantes emprunte les passes à poissons. En \Sexpr{annee}, elles ont été \Sexpr{gras(sum(subset(ang_video_agg_annee,station=="Poses")$bjo_valeur))} à être observées à Poses, \Sexpr{gras(sum(subset(ang_video_agg_annee,station=="Pontoise")$bjo_valeur))} à Pontoise et \Sexpr{gras(sum(subset(ang_video_agg_annee,station=="Carandeau")$bjo_valeur))} à Carandeau.
% 
% Plusieurs voies de franchissement sont en effet disponibles pour les anguilles argentées situées en amont des ouvrages :
% 
% – les passes à poissons,
% 
% – les exutoires de dévalaison,
% 
% – les écluses,
% 
% – les turbines de l’usine hydroélectrique (à Poses),
% 
% – les vannes des barrages.
% 
% Des études menées sur le Gave de Pau \citep{bau_suivi_2012} ont montré que la voie de franchissement utilisée par les anguilles dépend fortement du rapport de débit entre le débit total du cours d'eau et le débit turbiné. Lorsque le débit capté par la turbine dépasse le débit du fleuve, les anguilles franchissent majoritairement l’ouvrage par les turbines. En revanche, lorsque le débit du cours d’eau est au moins 1,5 fois supérieur au débit turbiné, cette voie devient minoritaire.
% 
% Des études menées sur les ouvrages de Seine aval par le bureau d'étude Profish confirment ces conclusions. Les passes à poissons et les écluses n'ont pratiquement pas été utilisées par les anguilles dévalantes marquées et les débits importants semblent favoriser une migration par l'ouvrage plutôt que par les turbines \citep{beguin_suivi_2025}.
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=\textwidth]{plot_annuel_agg}
% \caption{Effectifs journaliers des anguilles argentées recensés sur les STACOMI du bassin Seine.}
% \label{plot_annuel_agg}
% \end{figure}
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=\textwidth]{plot_historique_agg}
% \caption{Evolution interannuelle des effectifs d'anguille argentées recensés sur les STACOMI du bassin Seine. Les axes des ordonnées n'ont pas la même échelle. Début des comptages : Poses rive gauche en 2008, Poses rive droite et Carandeau en 2018, Pontoise en 2023.}
% \label{plot_historique_agg}
% \end{figure}
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=\textwidth,height=0.3\textheight,keepaspectratio]{p_horaires_agg}
% \caption{Horaires de migration des anguilles argentées en \Sexpr{annee}}
% \label{p_horaires_agg}
% \end{figure}
% 
% La migration de dévalaison est déclenchée par l'augmentation des débits, les passages se concentrent donc durant la période automnale et hivernale (Figure \ref{plot_annuel_agg}).
% 
% Les effectifs dévalants varient selon les années, allant de quelques dizaines à quelques centaines d'individus (Figure \ref{plot_historique_agg}).
% 
% Comme pour les autres stades de l'espèce, la migration de dévalaison se déroule principalement de nuit (Figure \ref{p_horaires_agg}).

\clearpage

\subsection{Lamproie fluviatile (\textit{Lampetra fluviatilis})}

<<chunk Lamproie fluviatile ,echo=FALSE, eval=FALSE,results='hide'>>=

r_mig_inter_lpf <- data_lpf
data_lpf <- subset(data_lpf@data, bjo_labelquantite=="Effectif_total")

# la migration des LPF peut commencer l'année n-1, on va recaler les cohortes. Si passage après le 30/09/n, ce poisson est placé dans la cohorte n+1.

data_lpf$cohorte <- if_else(data_lpf$bjo_jour >= paste0(data_lpf$bjo_annee,"-08-31"),data_lpf$bjo_annee+1,data_lpf$bjo_annee)
data_lpf<-subset(data_lpf,cohorte<annee+1)

data_lpf <- data_lpf %>%  mutate(station = case_when(
                            bjo_dis_identifiant %in% c(101,103,105)  ~ "Poses",
                            bjo_dis_identifiant %in% c(106,107)  ~ "Carandeau",
                            bjo_dis_identifiant == 108  ~ "Pontoise")) %>% 
                        mutate(rive = case_when(
                            bjo_dis_identifiant == 101  ~ "Poses rive gauche",
                            bjo_dis_identifiant %in% c(103,105)  ~ "Poses rive droite",
                            bjo_dis_identifiant %in% c(106,107)  ~ "Carandeau",
                            bjo_dis_identifiant == 108  ~ "Pontoise"))   %>% 
                        mutate(station=factor(station,levels=c("Poses","Pontoise","Carandeau"))) %>%
                        mutate(rive=factor(rive,levels=c("Poses rive gauche","Poses rive droite","Pontoise","Carandeau"))) 

##### plot annuel LPF ####

