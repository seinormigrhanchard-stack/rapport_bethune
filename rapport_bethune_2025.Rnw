                            bjo_dis_identifiant %in% c(106,107)  ~ "Carandeau",
                            bjo_dis_identifiant == 108  ~ "Pontoise"))   %>% 
                        group_by(bjo_jour,station,rive) %>% 
                        summarise(bjo_valeur=sum(-1*(bjo_valeur)))
ang_video_agg_annee <- ang_video_agg_annee %>%
                        mutate(station=factor(station,levels=c("Poses","Pontoise","Carandeau"))) %>%
