# A function factory for getting integer y-axis values.
integer_breaks <- function(n = 5, ...) {
    fxn <- function(x) {
        breaks <- floor(pretty(x, n, ...))
        names(breaks) <- attr(breaks, "labels")
        breaks
    }
    return(fxn)
}


## on définit la taille de l'export du plot horaires en fonction du nombre de station
fn_taille_export <- function(data){
  n <- length(unique(data$station))
  
  if (n == 3) return(list(width = 15, height = 10))
  if (n == 2) return(list(width = 10, height = 7))
  if (n == 1) return(list(width = 5, height = 3.5))
}

####### Fonction bilan  DC et DF ######

fndc<-function(le_dc=c(104)){
  r_dc=new("report_dc")
  r_dc<-choice_c(r_dc,
                 le_dc,
                 horodatedebut=str_c(annee,"-01-01"),
                 horodatefin=str_c(annee,"-12-31"),
                 silent=TRUE)
  Sys.setenv(TZ='GMT')
  report_dc<-connect(r_dc)
}

fndf<-function(le_df=c(1)){
  r_df=new("report_df")
  r_df<-choice_c(r_df,
                 le_df,
                 horodatedebut=str_c(annee,"-01-01"),
                 horodatefin=str_c(annee,"-12-31"),
                 silent=TRUE)
  Sys.setenv(TZ='GMT')
  report_df<-connect(r_df)
}

etat_levels <- c(
  "Fonc normal",
  "Arr ponctuel",
  "Arr maint",
  "Dysfonc",
  "Non connu"
)

etat_colors <- c(
  "Fonc normal" = "#1B9E77",
  "Arr ponctuel" = "#E6AB02",
  "Arr maint"   = "#9E0142",
  "Dysfonc"     = "#E41A1C",
  "Non connu"   = "#999999"
)

fn_plot_dc <- function(le_dc=c(dc_101)){
  plot(le_dc,plot.type=1)
  get_data_dc <- envir_stacomi$periodeDC
  get_data_dc$libelle <- factor(get_data_dc$libelle,levels = etat_levels)
  
  get_data_dc <- get_data_dc %>%
  complete(
    mois,
    libelle = etat_levels,
    fill = list(sumduree = 0)
  )
  
 get_plot_dc <- ggplot(get_data_dc, aes(x = mois, y = sumduree, fill = libelle)) +
    geom_col() +
    scale_fill_manual(
      values = etat_colors,
      limits = etat_levels,
      drop = FALSE,
      name = "état"
    ) +
    theme_bw() +
    ylab("durée (heures)") +
   theme(text = element_text(size = 15), plot.title = element_text(size=10))
  return(get_plot_dc)
}

fn_plot_df <- function(le_df=c(df_1)){
  plot(le_df,plot.type=1)
  get_data_df <- envir_stacomi$periodeDF
  
  get_data_df$libelle <- factor(get_data_df$libelle,levels = etat_levels)
  
  get_data_df <- get_data_df %>%
  complete(
    mois,
    libelle = etat_levels,
    fill = list(sumduree = 0)
  )
  
  get_plot_df <- ggplot(get_data_df, aes(x = mois, y = sumduree, fill = libelle)) +
    geom_col() +
    scale_fill_manual(
      values = etat_colors,
      limits = etat_levels,
      drop = FALSE,
      name = "état"
    ) +
    theme_bw() +
    ylab("durée (heures)") +
   theme(text = element_text(size = 15), plot.title = element_text(size=10))
  return(get_plot_df)
}

phrase_obs_pc <- function(data,
                          stations_ref = c("Pontoise", "Carandeau")) {

  resum <- data %>%
    mutate(station = as.character(station)) %>%
    filter(station %in% stations_ref) %>%
    group_by(station) %>%
    summarise(n = sum(bjo_valeur, na.rm = TRUE), .groups = "drop") %>%
    right_join(tibble(station = stations_ref), by = "station") %>%
    mutate(n = tidyr::replace_na(n, 0L)) %>%
    mutate(station = factor(station, levels = stations_ref)) %>%
    arrange(station)

  n1 <- resum$n[1]
  n2 <- resum$n[2]
  st1 <- resum$station[1]
  st2 <- resum$station[2]

  # -------- Cas spécial : aucun aux deux --------
  if (n1 == 0 && n2 == 0) {
    return(str_c("Cette année, ",gras("aucun")," individu n’a été observé à Pontoise et à Carandeau."))
  }

  # -------- Construction du segment 1 --------
  seg1 <- dplyr::case_when(
    n1 == 0 ~ str_c(gras("aucun")," individu n’a été observé"),
    n1 == 1 ~ str_c(gras("1")," individu a été observé"),
    TRUE    ~ paste0(gras(n1), " individus ont été observés")
  )
  seg1 <- paste(seg1, "à", st1)

  # -------- Construction du segment 2 (forme courte) --------
  seg2 <- dplyr::case_when(
    n2 == 0 ~ str_c(gras("aucun")," à"),
    n2 == 1 ~ str_c(gras("1")," à"),
    TRUE    ~ paste0(gras(n2), " à")
  )
  seg2 <- paste(seg2, st2)

  # -------- Phrase finale --------
  glue::glue("Cette année, {seg1} et {seg2}.")
}
@

<<chunk debit,echo=FALSE,eval=TRUE,results='hide'>>=
## Debit histo Seine ##

QmM<-get_hydrometrie_obs_elab(code_entite = "G206021010", grandeur_hydro_elab = "QmM")
QmM<-subset(QmM,date_obs_elab<=str_c(annee,"12-01"))
QmM$mois<-month(QmM$date_obs_elab)
QmM<-summarise(group_by(QmM,mois),Q_mean_month=round(mean(resultat_obs_elab/1000,na.rm = TRUE),1))
QmM$mois<-as.Date(str_c(annee,"-",QmM$mois,"-01"),tz="GMT")

QmM_poly <- QmM %>%
  mutate(
    date_debut = as_date(mois),
    date_fin   = (as_date(mois) %m+% months(1)) - days(1),
    mois_centre = date_debut + (date_fin - date_debut) / 2   
  )

# Liste des breaks EXACTS (pas d'extra)
breaks_mois <- QmM_poly$mois_centre
labels_mois <- format(breaks_mois, "%b")  # noms des mois en français

QmnJ<-get_hydrometrie_obs_elab(code_entite = "G206021010",date_debut_obs_elab = str_c(annee,"-01-01"),
                               date_fin_obs_elab = str_c(annee,"-12-31"),grandeur_hydro_elab = "QmnJ")
QmnJ$resultat_obs_elab<-QmnJ$resultat_obs_elab/1000
QmnJ$date_obs_elab<-as.Date(QmnJ$date_obs_elab)

debit_bethune<-ggplot() +
  geom_rect(
    data = QmM_poly,
    aes(
      xmin = date_debut,
      xmax = date_fin,
      ymin = 0,
      ymax = Q_mean_month
    ),
    fill = "#2C80D3", alpha = 0.8, color = NA
  )+
  geom_line(data = QmnJ,
            aes(x = date_obs_elab, y = resultat_obs_elab),
            color = "black", linewidth = 1) +

    scale_x_date(
    breaks = breaks_mois,
    labels = labels_mois,
    expand = c(0,0)
  ) +
  labs(x = "", y = bquote(bold('débits ('* ~ m^3/s*')')),title = "Débits de la Béthune à Saint-Aubin-le-Cauf") +
  theme_bw()+
    theme(
    axis.text = element_text(size = 15),
    axis.title.y = element_text(size = 15),
    legend.position = "right",
    legend.title = element_blank(),
    legend.text = element_text(size = 15)
  ) + 
  scale_y_continuous(labels = scales::comma_format(scale = 1, prefix = "", suffix = "",  big.mark = " ", decimal.mark = "."))

debit_bethune <-  debit_bethune + 
  plot_annotation(caption = "Source des données : HydroPortail")           

png(file=str_c(imgwd,"debit_bethune.png"),width=10,height=8,unit="in",res=200)
print(debit_bethune)
dev.off()

