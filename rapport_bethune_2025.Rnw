data_taille_sat<-subset(data_taille_video, tax_nom_latin == "Salmo salar")
data_taille_sat <- data_taille_sat %>% 
                          mutate(station = case_when(
                            ope_dic_identifiant %in% c(101,103,105)  ~ "Poses",
                            ope_dic_identifiant == 108  ~ "Pontoise")) %>%
                          filter(station == "Poses") %>%
                            mutate(classe_taille=cut(
                            car_valeur_quantitatif,
                            breaks=c(0,300,350,400,450,500,550,600,650,700,750,800,850,900,950,1000,2000),
                            labels = c("<300","300-350","350-400","400-450","450-500","500-550","550-600",
                            "600-650","650-700","700-750","750-800","800-850","850-900","900-950","950-1000",">1000"),
                            include.lowest = TRUE,
                            right = FALSE ))%>%
                             mutate(age_de_mer=cut(
                            car_valeur_quantitatif,
                            breaks=c(0,670,900,2000),
                            labels = c("1 HM","2 HM","3 HM"),
                            include.lowest = TRUE,
                            right = FALSE ))%>% 
                        mutate(station=factor(station,levels=c("Poses","Pontoise","Carandeau")))%>% 
                        mutate(age_de_mer=factor(age_de_mer,levels=c("3 HM","2 HM","1 HM")))

freq_taille_histo <- data_taille_sat %>% 
                      filter(annee != selected_annee) %>%
                      group_by(station,classe_taille) %>%
  summarise(effectif = n(), .groups = "drop")

freq_taille_histo <- freq_taille_histo %>%
  group_by(station) %>%
  mutate(frequence = effectif / sum(effectif)*100) %>%
  ungroup() %>% mutate(annee=2000)

freq_taille_annee <- data_taille_sat %>% 
                      filter(annee == selected_annee) %>%
                      group_by(station,classe_taille) %>%
  summarise(effectif = n(), .groups = "drop")

freq_taille_annee <- freq_taille_annee %>%
  group_by(station) %>%
  mutate(frequence = effectif / sum(effectif)*100) %>%
  ungroup() %>% mutate(annee = selected_annee)

freq_taille_sat<-rbind(freq_taille_histo,freq_taille_annee)

plot_histo_taille_sat<-ggplot()+
  geom_bar(data=subset(freq_taille_sat,annee!=selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",alpha=0.5)+
  geom_bar(data=subset(freq_taille_sat,annee==selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",width=0.5)+
 # facet_grid(rows=vars(station))+
      scale_fill_manual(values = c("Poses" = col_Poses,
                                    "Pontoise" = col_Pontoise,
                                    "Carandeau" =  col_Carandeau
                                               ),
                                    drop = FALSE)+
  theme_bw()+ xlab("Classe de taille (mm)")+ylab("Proportion des classe de taille (%)")+
  scale_x_discrete(drop=FALSE)+
  theme(text = element_text(size = 15),
        axis.text.x = element_text(angle=45,vjust=0.5),
        plot.margin = margin(0.2, 0.2, 0, 0, "cm"))+
  guides(fill="none")

png(file=str_c(imgwd,"plot_histo_taille_sat.png"),width=5,height=4,unit="in",res=200)
