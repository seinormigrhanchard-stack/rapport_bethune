<<chunk recap migration, eval=FALSE, echo=FALSE, results='hide'>>=

mig_annee_poses_rg<-subset(bilesp_poses_vc_rg,tax_nom_latin %in% c("Anguilla anguilla","Alosa","Salmo trutta trutta","Salmo salar",
                           "Petromyzon marinus","Chelon ramada"))
mig_annee_poses_rd<-subset(bilesp_poses_vc_rd,tax_nom_latin %in% c("Anguilla anguilla","Alosa","Salmo trutta trutta","Salmo salar",
                           "Petromyzon marinus","Chelon ramada"))

mig_ang_poses_piege<-subset(data_ang[[1]]@data,bjo_labelquantite=="Effectif_total" & bjo_annee==annee)
mig_ang_poses_piege<-summarise(group_by(mig_ang_poses_piege,bjo_tax_code,bjo_std_code,bjo_dis_identifiant),effectifs=round(sum(bjo_valeur)))
mig_ang_poses_piege$bjo_std_code<-"CIV"
mig_ang_poses_piege <- mig_ang_poses_piege %>% rename(lot_tax_code = bjo_tax_code,lot_std_code = bjo_std_code)

mig_ang_poses_piege_rg <- mig_ang_poses_piege %>% filter(bjo_dis_identifiant == 102) %>% 
                                                  rename(effectifs_poses_rg = effectifs) %>% 
                                                  select(1,2,4)
mig_ang_poses_piege_rd <- mig_ang_poses_piege %>% filter(bjo_dis_identifiant == 104) %>% 
                                                  rename(effectifs_poses_rd = effectifs) %>% 
                                                  select(1,2,4)

mig_annee_poses_rg<-summarise(group_by(mig_annee_poses_rg,lot_tax_code,lot_std_code),effectifs_poses_rg=sum(lot_effectif))
mig_annee_poses_rd<-summarise(group_by(mig_annee_poses_rd,lot_tax_code,lot_std_code),effectifs_poses_rd=sum(lot_effectif))

mig_annee_poses_rg<-rbind(mig_annee_poses_rg,mig_ang_poses_piege_rg)
mig_annee_poses_rd<-rbind(mig_annee_poses_rd,mig_ang_poses_piege_rd)

lpf_poses_rg<-subset(data_lpf@data,bjo_dis_identifiant == "101" &
                       between(bjo_jour,as.Date(str_c(annee-1,"-08-31")),as.Date(str_c(annee,"-08-31"))) & bjo_labelquantite=="Effectif_total") 
lpf_poses_rd<-subset(data_lpf@data,bjo_dis_identifiant %in% c(103,105) &
                       between(bjo_jour,as.Date(str_c(annee-1,"-08-31")),as.Date(str_c(annee,"-08-31"))) & bjo_labelquantite=="Effectif_total") 

mig_annee_poses_rg<-mig_annee_poses_rg %>% mutate(Espèces = case_when(
                            lot_tax_code == "2038" & lot_std_code =="CIV" ~ "Anguille en montaison (passe piège)",
                            lot_tax_code == "2038" & lot_std_code =="4" ~ "Anguille jaune (vidéocomptage)",
                            lot_tax_code == "2038" & lot_std_code =="AGG" ~ "Anguille argentée",
                            lot_tax_code == "2014" & lot_std_code =="5" ~ "Lamproie marine",
                            lot_tax_code == "2055" & lot_std_code =="5" ~ "Alose",
                            lot_tax_code == "2183" & lot_std_code =="5" ~ "Mulet porc",
                            lot_tax_code == "2220" & lot_std_code =="5" ~ "Saumon atlantique",
                            lot_tax_code == "2224" & lot_std_code =="5" ~ "Truite de mer"
                           )) %>% ungroup() %>% select(4,3)
mig_annee_poses_rg<-rbind(mig_annee_poses_rg, tibble(`Espèces`= c("Lamproie fluviatile"),effectifs_poses_rg= sum(lpf_poses_rg$bjo_valeur)))

mig_annee_poses_rd<-mig_annee_poses_rd %>% mutate(Espèces = case_when(
                            lot_tax_code == "2038" & lot_std_code =="CIV" ~ "Anguille en montaison (passe piège)",
                            lot_tax_code == "2038" & lot_std_code =="4" ~ "Anguille jaune (vidéocomptage)",
                            lot_tax_code == "2038" & lot_std_code =="AGG" ~ "Anguille argentée",
                            lot_tax_code == "2014" & lot_std_code =="5" ~ "Lamproie marine",
                            lot_tax_code == "2055" & lot_std_code =="5" ~ "Alose",
                            lot_tax_code == "2183" & lot_std_code =="5" ~ "Mulet porc",
                            lot_tax_code == "2220" & lot_std_code =="5" ~ "Saumon atlantique",
                            lot_tax_code == "2224" & lot_std_code =="5" ~ "Truite de mer",
                           )) %>% ungroup() %>% select(4,3)
mig_annee_poses_rd<-rbind(mig_annee_poses_rd, tibble(`Espèces`= c("Lamproie fluviatile"),effectifs_poses_rd= sum(lpf_poses_rd$bjo_valeur)))

mig_annee_pontoise<-subset(bilesp_pontoise,tax_nom_latin %in% c("Anguilla anguilla","Alosa","Salmo trutta trutta","Salmo salar",
                           "Lampetra fluviatilis","Petromyzon marinus","Chelon ramada"))
mig_annee_pontoise<-summarise(group_by(mig_annee_pontoise,lot_tax_code,lot_std_code),effectifs_pontoise=sum(lot_effectif))
mig_annee_pontoise<-mig_annee_pontoise %>% mutate(Espèces = case_when(
                            #lot_tax_code == "2038" & lot_std_code =="CIV" ~ "Anguille en montaison (passe piège)",
                            lot_tax_code == "2038" & lot_std_code =="4" ~ "Anguille jaune (vidéocomptage)",
                            lot_tax_code == "2038" & lot_std_code =="AGG" ~ "Anguille argentée",
                            lot_tax_code == "2011" & lot_std_code =="5" ~ "Lamproie fluviatile",
                            lot_tax_code == "2014" & lot_std_code =="5" ~ "Lamproie marine",
                            lot_tax_code == "2055" & lot_std_code =="5" ~ "Alose",
                            lot_tax_code == "2183" & lot_std_code =="5" ~ "Mulet porc",
                            lot_tax_code == "2220" & lot_std_code =="5" ~ "Saumon atlantique",
                            lot_tax_code == "2224" & lot_std_code =="5" ~ "Truite de mer"
                           ))%>% ungroup() %>% select(4,3)


mig_annee_carandeau<-subset(bilesp_carandeau,tax_nom_latin %in% c("Anguilla anguilla","Alosa","Salmo trutta trutta","Salmo salar",
                           "Lampetra fluviatilis","Petromyzon marinus","Chelon ramada"))
mig_annee_carandeau<-summarise(group_by(mig_annee_carandeau,lot_tax_code,lot_std_code),effectifs_carandeau=sum(lot_effectif))
mig_annee_carandeau<- mig_annee_carandeau %>% mutate(Espèces = case_when(
                            #lot_tax_code == "2038" & lot_std_code =="CIV" ~ "Anguille en montaison (passe piège)",
                            lot_tax_code == "2038" & lot_std_code =="4" ~ "Anguille jaune (vidéocomptage)",
                            lot_tax_code == "2038" & lot_std_code =="AGG" ~ "Anguille argentée",
                            lot_tax_code == "2011" & lot_std_code =="5" ~ "Lamproie fluviatile",
                            lot_tax_code == "2014" & lot_std_code =="5" ~ "Lamproie marine",
                            lot_tax_code == "2055" & lot_std_code =="5" ~ "Alose",
                            lot_tax_code == "2183" & lot_std_code =="5" ~ "Mulet porc",
                            lot_tax_code == "2220" & lot_std_code =="5" ~ "Saumon atlantique",
                            lot_tax_code == "2224" & lot_std_code =="5" ~ "Truite de mer"
                           )) %>% ungroup() %>% select(4,3)

resume_poses<-full_join(mig_annee_poses_rg,mig_annee_poses_rd,by=c("Espèces")) %>%
  rowwise(Espèces) %>% 
  mutate(total_poses = sum(c(effectifs_poses_rg,effectifs_poses_rd),na.rm = T))

resume <-resume_poses %>% 
  full_join(mig_annee_pontoise,by=c("Espèces")) %>% 
  full_join(mig_annee_carandeau,by=c("Espèces")) %>%
  drop_na(Espèces)


resume<-resume %>% rename("Poses rive gauche" = effectifs_poses_rg, "Poses rive droite" = effectifs_poses_rd, "Total Poses" = total_poses,
                  "Pontoise" = effectifs_pontoise, "Carandeau" = effectifs_carandeau) %>% as.data.frame()
rownames(resume)<-resume[,1]
resume<-select(resume,-1) 

resume<-resume[c("Alose","Anguille en montaison (passe piège)","Anguille jaune (vidéocomptage)","Anguille argentée","Lamproie fluviatile",
          "Lamproie marine","Mulet porc","Saumon atlantique","Truite de mer"),]

resume2 <- resume %>%
  tibble::rownames_to_column(var = "Espèce") %>%
  mutate(across(where(is.numeric), ~replace_na(.x, 0)))

resume2[2:6]<-format(resume2[2:6],big.mark = " ")

resume2 <- resume2 %>%
  mutate(
    Pontoise  = if_else(`Espèce` == "Anguille en montaison (passe piège)", "", Pontoise),
    Carandeau = if_else(`Espèce` == "Anguille en montaison (passe piège)", "", Carandeau)) %>%
   rename(Espèces = Espèce)

resume_latex <- resume2 %>%
  kbl(
    caption = "Effectifs annuels des poissons migrateurs comptabilisés sur les stations de contrôle des migrations du bassin de la Seine",
    booktabs = TRUE,
    format = "latex",
    escape = FALSE,
    linesep = "",
    label = "recap"
  ) %>%
  kable_styling(
    latex_options = c("striped","hold_position", "scale_down"),
    position = "center",
    full_width = FALSE
  ) %>%
  column_spec(1, width = "6cm") %>%
  column_spec(2, latex_column_spec = "C{2cm}", bold = F) %>%
  column_spec(3, latex_column_spec = "C{2cm}", bold = F) %>%
  column_spec(4, latex_column_spec = "C{2cm}", bold = TRUE) %>%
  column_spec(5, latex_column_spec = "C{2cm}", bold = TRUE) %>%
  column_spec(6, latex_column_spec = "C{2cm}", bold = TRUE) %>%
  add_header_above(c(" " = 1, "Seine" = 3, "Oise" = 1, "Aisne" = 1))

writeLines(resume_latex, str_c(tabwd, "recap.tex"))

@


% Les poissons migrateurs entrant dans l'estuaire de la Seine sont contrôlés au niveau du barrage de Poses, marquant la fin de l'estuaire. Cette ouvrage est équipé de dispositifs de franchissement piscicole et de comptage sur les deux rives. Les individus s'engageant sur l'axe Oise peuvent ensuite être observés au barrage de Pontoise, équipé d'un système de vidéocomptage depuis 2023. Un dernier point de contrôle est positionné sur l'Aisne, au barrage de Carandeau depuis 2018.
% Les effectifs comptabilisés en \Sexpr{annee} sur l'ensemble de ces stations sont présentés dans le tableau \ref{tab:recap}. Les valeurs négatives correspondent à des individus dévalants enregistrés lors du vidéocomptage.
