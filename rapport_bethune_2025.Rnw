  image_border(color = "white", geometry = "15x15") 
  
image_write(img, path = file.path(imgwd, "p_horaires_agj.png"))

@

% Dans les passes à bassins,les anguilles jaunes observées peuvent être en phase de migration active ou sédentaires, se déplaçant pour rechercher de la nourriture, des habitats ou des zones de repos. Elles peuvent circuler dans les deux sens (montaison et dévalaison). Ainsi, la somme des effectifs comptabilisés peut être négative certaines années. Pour l'année \Sexpr{annee}, les totaux sont de \Sexpr{gras(valeurs_agj_annuelles[1])} à Poses, \Sexpr{gras(valeurs_agj_annuelles[2])} Pontoise et \Sexpr{gras(valeurs_agj_annuelles[3])} à Carandeau.
% 
% À Pontoise, en raison d'un problème de conception du couloir de vidéocomptage, le comptage des petites espèces, notamment des jeunes anguilles, n'est pas exhaustif. En effet, le radier ne couvre pas l'ensemble du couloir et présente deux voies de passages au niveau des vitres, non couvertes par la caméra, par lesquelles les petits poissons peuvent circuler.
% 
% Il est ainsi fréquent que des anguilles apparaissent directement au milieu du couloir, sans possibilité d'identifier leur sens de migration. Elles sont alors enregistrées dans le logiciel avec un sens \textquote{indéterminé}.
% 
% Les données de cette station ne permettent donc pas de d'estimer un nombre d'anguilles en montaison et doivent donc être considérées à titre informatif. L'espèce est néanmoins bien présente sur cette station, puisque le nombre total d'observations, tous sens de migration confondus (montaison, dévalaison ou indéterminé) atteint \Sexpr{format(nrow(subset(bilesp_pontoise,lot_tax_code=="2038" & std_libelle == "Juvénile")),big.mark=" ")} individus.
% 
% L'activité est concentrée entre mai et septembre (Figure \ref{plot_annuel_agj}), avec un pic d’intensité au printemps, période correspondant à la hausse saisonnière des températures de l’eau.
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=\textwidth]{plot_annuel_agj}
% \caption{Effectifs journaliers des anguilles jaunes recensés sur les STACOMI du bassin Seine.}
% \label{plot_annuel_agj}
% \end{figure}
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=\textwidth]{plot_historique_agj}
% \caption{Evolution interannuelle des effectifs d'anguille jaune recensés sur les STACOMI du bassin Seine. Les individus dévalants (codés en \textquote{-1}) sont transformés en valeur positive afin de mieux représenter le volume des anguilles ayant transité par les passes à poissons. Les axes des ordonnées n'ont pas la même échelle. Début des comptages : Poses rive gauche en 2008, Poses rive droite et Carandeau en 2018, Pontoise en 2023.}
% \label{plot_historique_agj}
% \end{figure}
% 
% Les données historiques montrent des effectifs variables selon les années, mais globalement compris entre quelques dizaines et quelques centaines d'individus, avec des valeurs logiquement plus importantes à Poses (Figure \ref{plot_historique_agj}).
% 
% Concernant les tailles, les jeunes individus sont majoritaires sur le barrage de Poses. A Pontoise, on observe une proportion importante d'individus < 300 mm, caractéristique des anguilles en phase de migration active.
% 
% L'activité horaire est majoritairement nocturne, conformément au comportement connu de l’espèce (Figure \ref{p_horaires_agj}).
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=\textwidth]{plot_histo_taille_agj}
% \caption{Distribution de tailles des anguilles jaunes mesurées aux stations de Poses et de Pontoise. Les tailles historiques sont présentées en transparence.}
% \label{plot_histo_taille_agj}
% \end{figure}
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=\textwidth,height=0.3\textheight,keepaspectratio]{p_horaires_agj}
% \caption{Horaires de migration des anguilles jaunes en \Sexpr{annee}}
% \label{p_horaires_agj}
% \end{figure}

\clearpage

