recap_stade_trm <- data_taille_trm %>% 
  group_by(annee, tax_nom_latin, age_de_mer) %>% 
  summarise(sum = sum(lot_effectif), .groups = "drop") %>% 
  group_by(annee) %>% 
  mutate(percentage = sum / sum(sum)) %>% 
  ungroup() %>% 
  as.data.frame()
recap_stade_trm$annee<-lubridate::year(as.Date(recap_stade_trm$annee, format = "%Y"))
recap_stade_trm$annee <- factor(recap_stade_trm$annee)

plot_age_de_mer_trm<-ggplot(
    recap_stade_trm,
    aes(x = annee, y = percentage, fill = age_de_mer)
) +
    geom_col(width = 1, color = "black", linewidth = 0.3) +
    scale_x_discrete(expand = c(0, 0)) +
    scale_y_continuous(labels = scales::percent,limits = c(0,1)) +
    scale_fill_viridis_d(name = "Âge de mer") +
    theme_bw() +
    ylab("Proportion (%)") +
    xlab("")+
  theme(axis.text=element_text(size=15),
        axis.text.x = element_text(angle=45,vjust=0.5,size=12),
        legend.position = "bottom",
        plot.margin = margin(0.2, 0.2, 0, 0, "cm"))  # top, right, bottom, left

