data_taille_ang_piege <- data_taille_ang_piege %>% 
                          mutate(station = case_when(
                            ope_dic_identifiant == 102  ~ "Poses rive gauche",
                            ope_dic_identifiant == 104  ~ "Poses rive droite")) %>%
  
  mutate(classe_taille=cut( car_valeur_quantitatif,
                            breaks=c(0,60,70,80,90,100,110,120,130,
                                    140,150,160,170,180,190,200,
                                    210,220,230,240,250,600),
                            labels = c("<60","60-70","70-80","80-90","90-100","100-110","110-120","120-130",
             "130-140","140-150","150-160","160-170","170-180","180-190","190-200",
             "200-210","210-220","220-230","230-240","240-250",">250"),
                            include.lowest = TRUE,
                            right = FALSE ))%>%
                        mutate(station=factor(station,levels=c("Poses rive gauche","Poses rive droite")))

data_taille_ang_piege$mois <- factor(
  data_taille_ang_piege$mois,
  levels = sprintf("%02d", 1:12),
  labels = mois_fr
)

plot_box_violin_plot_angmont <-
  ggplot()+
  geom_violin(data=subset(data_taille_ang_piege,annee==selected_annee), aes(y=car_valeur_quantitatif,x=mois,fill=station),alpha=1)+
  geom_boxplot(data=subset(data_taille_ang_piege,annee!=selected_annee), aes(y=car_valeur_quantitatif,x=mois,fill=station),alpha=0.5)+
  facet_grid(rows=vars(station))+
                  scale_fill_manual(values = c("Poses rive droite" = col_Poses_RD,
                                               "Poses rive gauche" = col_Poses_RG
                                               ),
                                    drop = FALSE)+
  theme_bw() +
  labs(x = "mois", y = "taille (mm)")+
  theme(text = element_text(size = 15))+guides(fill="none")

png(file=str_c(imgwd,"plot_box_violin_plot_angmont.png"),width=5,height=4,unit="in",res=200)
print(plot_box_violin_plot_angmont)
dev.off()

#### plot taille ang mont geom_bar ####

freq_taille_histo <- data_taille_ang_piege %>% 
                      filter(annee != selected_annee) %>%
                      group_by(station,classe_taille) %>%
  summarise(effectif = n(), .groups = "drop")

freq_taille_histo <- freq_taille_histo %>%
  group_by(station) %>%
  mutate(frequence = effectif / sum(effectif)*100) %>%
  ungroup() %>% mutate(annee=2000)

freq_taille_annee <- data_taille_ang_piege %>% 
                      filter(annee == selected_annee) %>%
                      group_by(station,classe_taille) %>%
  summarise(effectif = n(), .groups = "drop")

freq_taille_annee <- freq_taille_annee %>%
  group_by(station) %>%
  mutate(frequence = effectif / sum(effectif)*100) %>%
  ungroup() %>% mutate(annee = selected_annee)

freq_taille_angmont<-rbind(freq_taille_histo,freq_taille_annee)

plot_histo_taille_angmont<-ggplot()+
  geom_bar(data=subset(freq_taille_angmont,annee!=selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",alpha=0.5)+
  geom_bar(data=subset(freq_taille_angmont,annee==selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",width=0.5)+
  facet_grid(rows=vars(station))+
  scale_fill_manual(values = c(col_Poses_RD,col_Poses_RG),
                            labels = c("Poses rive droite", "Poses rive gauche"))+
  theme_bw()+ xlab("Classe de taille (mm)")+ylab("Proportion des classe de taille (%)")+
scale_x_discrete(drop=FALSE)+
  theme(text = element_text(size = 15),axis.text.x = element_text(angle=45,vjust=0.5))+guides(fill="none")

png(file=str_c(imgwd,"plot_histo_taille_angmont.png"),width=5,height=4,unit="in",res=200)
print(plot_histo_taille_angmont)
dev.off()

#### plot effectifs historique ang montaison #####

data_angmont_histo <- rbind(data_ang_mont_poses_RD,data_ang_mont_poses_RG)
data_angmont_histo <- data_angmont_histo %>%   
                                  mutate(station = case_when(
                            bjo_dis_identifiant == 102  ~ "Poses rive gauche",
                            bjo_dis_identifiant == 104  ~ "Poses rive droite")) %>%
                                  mutate(station=factor(station,levels=c("Poses rive gauche","Poses rive droite"))) %>%
                                  group_by(station,bjo_annee) %>%
                                  summarise(effectif=round(sum(bjo_valeur)))

plot_historique_angmont<- ggplot() +
    geom_bar(
        data = data_angmont_histo,
        aes(x = bjo_annee, y = effectif, fill = station),
        stat = "identity")+
                    scale_fill_manual(values = c("Poses rive gauche" = col_Poses_RG,
                                                 "Poses rive droite" = col_Poses_RD,
                                               "Pontoise" = col_Pontoise,
                                               "Carandeau" =  col_Carandeau
                                               ),
                                    drop = FALSE,
        breaks = c("Poses rive gauche", "Poses rive droite"),  # <-- Seuls ces deux apparaissent en légende
        name   = "Rive (Poses)",
        labels = c("Gauche", "Droite")
    ) +
    theme_bw() + xlab("") +
    theme(text = element_text(size = 15)) + #,legend.position = "bottom")+ 
  scale_y_continuous(labels = scales::comma_format(scale = 1, prefix = "", suffix = "",  big.mark = " ", decimal.mark = "."))
png(file=str_c(imgwd,"plot_historique_angmont.png"),width=8,height=4,unit="in",res=200)
print(plot_historique_angmont)
dev.off()

