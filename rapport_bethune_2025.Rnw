                  facet_grid(rows=vars(station))+ xlab("")+ylab("Effectifs")+
                    scale_fill_manual(values = c("Poses rive gauche" = col_Poses_RG,
                                                 "Poses rive droite" = col_Poses_RD,
                                               "Pontoise" = col_Pontoise,
                                               "Carandeau" =  col_Carandeau
                                               ),
                                    drop = FALSE,
        breaks = c("Poses rive gauche", "Poses rive droite"),  # <-- Seuls ces deux apparaissent en légende
        name   = "Rive (Poses)",
        labels = c("Gauche", "Droite")
    ) +
                  theme_bw()+
                  theme(text = element_text(size = 15))+ 
  scale_y_continuous(labels = scales::comma_format(scale = 1, prefix = "", suffix = "",  big.mark = " ", decimal.mark = "."))

png(file=str_c(imgwd,"plot_annuel_agj.png"),width=8,height=4,unit="in",res=200)
print(plot_annuel_agj)
dev.off()

