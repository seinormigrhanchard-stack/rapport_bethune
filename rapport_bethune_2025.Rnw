data_taille_lpm<-subset(data_taille_video, tax_nom_latin == "Petromyzon marinus")
data_taille_lpm <- data_taille_lpm %>% 
                          filter(ope_dic_identifiant %in% c(101,103,105)) %>% 
                          filter(ope_date_debut >= "2021-01-01") %>% ###  il y a des valeurs bizarres quand le dépouillement était fait par la Base de Loisirs (confusion LPM/LPF)
                          mutate(station = case_when(
                            ope_dic_identifiant %in% c(101,103,105)  ~ "Poses")) %>%
                          mutate(classe_taille=cut(
                            car_valeur_quantitatif,
                            breaks=c(0,300,350,400,450,500,550,600,650,700,750,800,850,900,950,1000,2000),
                            labels = c("<300","300-350","350-400","400-450","450-500","500-550","550-600",
                            "600-650","650-700","700-750","750-800","800-850","850-900","900-950","950-1000",">1000"),
                            include.lowest = TRUE,
                            right = FALSE ))%>%
                        mutate(station=factor(station,levels=c("Poses")))

freq_taille_histo <- data_taille_lpm %>% 
                      filter(annee != selected_annee) %>%
                      group_by(station,classe_taille) %>%
  summarise(effectif = n(), .groups = "drop")

freq_taille_histo <- freq_taille_histo %>%
  group_by(station) %>%
  mutate(frequence = effectif / sum(effectif)*100) %>%
  ungroup() %>% mutate(annee=2000)

freq_taille_annee <- data_taille_lpm %>% 
                      filter(annee == selected_annee) %>%
                      group_by(station,classe_taille) %>%
  summarise(effectif = n(), .groups = "drop")

freq_taille_annee <- freq_taille_annee %>%
  group_by(station) %>%
  mutate(frequence = effectif / sum(effectif)*100) %>%
  ungroup() %>% mutate(annee = selected_annee)

freq_taille_lpm<-rbind(freq_taille_histo,freq_taille_annee)

plot_histo_taille_lpm<-ggplot()+
  geom_bar(data=subset(freq_taille_lpm,annee!=selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",alpha=0.5)+
  geom_bar(data=subset(freq_taille_lpm,annee==selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",width=0.5)+
 # facet_grid(rows=vars(station))+
      scale_fill_manual(values = c("Poses" = col_Poses,
                                    "Pontoise" = col_Pontoise,
                                    "Carandeau" =  col_Carandeau
                                               ),
                                    drop = FALSE)+
  theme_bw()+ xlab("Classe de taille (mm)")+ylab("Proportion des classe de taille (%)")+
  scale_x_discrete(drop=FALSE)+
  theme(text = element_text(size = 15),
        axis.text.x = element_text(angle=45,vjust=0.5),
        plot.margin = margin(0.1, 0, 0, 0, "cm")) +  # top, right, bottom, left
  guides(fill="none")

png(file=str_c(imgwd,"plot_histo_taille_lpm.png"),width=8,height=4,unit="in",res=200)
