data_sat_poses<-data_sat[[1]]
data_sat_poses_annee<-subset(data_sat_poses@data,bjo_annee==annee & bjo_labelquantite=="Effectif_total")

data_sat_pontoise<- data_sat[[3]]
data_sat_pontoise_annee <- subset(data_sat_pontoise@data,bjo_annee==annee & bjo_labelquantite=="Effectif_total")

data_sat_carandeau <- data_sat[[2]]
data_sat_carandeau_annee <- subset(data_sat_carandeau@data,bjo_annee==annee & bjo_labelquantite=="Effectif_total")

#### plot annuelle SAT ####

data_sat_annuelle<-rbind(data_sat_poses_annee,data_sat_pontoise_annee,data_sat_carandeau_annee)
data_sat_annuelle <- data_sat_annuelle %>% mutate(station = case_when(
                            bjo_dis_identifiant %in% c(101,103,105)  ~ "Poses",
                            bjo_dis_identifiant %in% c(106,107)  ~ "Carandeau",
                            bjo_dis_identifiant == 108  ~ "Pontoise")) %>%
                        mutate(rive = case_when(
                            bjo_dis_identifiant == 101  ~ "Poses rive gauche",
                            bjo_dis_identifiant %in% c(103,105)  ~ "Poses rive droite",
                            bjo_dis_identifiant %in% c(106,107)  ~ "Carandeau",
                            bjo_dis_identifiant == 108  ~ "Pontoise")) 

data_sat_annuelle <- data_sat_annuelle %>% 
                        group_by(bjo_jour,station,rive) %>% 
                        summarise(bjo_valeur=sum(bjo_valeur))
data_sat_annuelle <- data_sat_annuelle %>%
                        mutate(station=factor(station,levels=c("Poses","Pontoise","Carandeau")))%>%
                        mutate(rive=factor(rive,levels=c("Poses rive gauche","Poses rive droite","Pontoise","Carandeau")))

plot_annuel_sat<-ggplot(data_sat_annuelle)+geom_bar(aes(x=as.Date(bjo_jour),y=bjo_valeur,fill=rive),stat = "identity")+
                  facet_grid(rows=vars(station))+ xlab("")+ylab("Effectifs")+
                    scale_fill_manual(values = c("Poses rive gauche" = col_Poses_RG,
                                                 "Poses rive droite" = col_Poses_RD,
                                               "Pontoise" = col_Pontoise,
                                               "Carandeau" =  col_Carandeau
                                               ),
                                    drop = FALSE,
        breaks = c("Poses rive gauche", "Poses rive droite"),  # <-- Seuls ces deux apparaissent en légende
        name   = "Rive (Poses)",
        labels = c("Gauche", "Droite")
    ) +
                  theme_bw()+
                  theme(text = element_text(size = 15))+#guides(fill="none")+ 
  scale_y_continuous(labels = scales::comma_format(scale = 1, prefix = "", suffix = "",  big.mark = " ", decimal.mark = "."))

png(file=str_c(imgwd,"plot_annuel_sat.png"),width=8,height=4,unit="in",res=200)
print(plot_annuel_sat)
dev.off()

