        breaks = c("Poses rive gauche", "Poses rive droite"),  # <-- Seuls ces deux apparaissent en légende
        name   = "Rive (Poses)",
        labels = c("Gauche", "Droite")
    ) +
                  theme_bw()+
                  theme(text = element_text(size = 15))+#guides(fill="none")+ 
  scale_y_continuous(labels = scales::comma_format(scale = 1, prefix = "", suffix = "",  big.mark = " ", decimal.mark = "."))

