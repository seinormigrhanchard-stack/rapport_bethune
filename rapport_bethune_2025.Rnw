@

% Le premier individu s'est présenté le \Sexpr{format.Date(min(data_trm_poses_annee$bjo_jour),"%d %B")} au barrage de Poses, afin d'amorcer la première vague de migration dite \og printanière \fg{} (Figure \ref{TRM}). En effet, au même titre que le saumon, l'activité migratoire de la truite de mer s'articule autour de deux vagues de migration au printemps et à l'automne. Au total, \Sexpr{gras(sum(data_trm_poses_annee$bjo_valeur))} individus ont été recensés en montaison à Poses (Figure \ref{plot_annuel_trm}). \Sexpr{phrase_effectif_pont_carand_trm}
% 
% \begin{figure}[hptb]
%   \centering
%     \begin{subfigure}[b]{0.3\textwidth}
%         \includegraphics[width=\textwidth]{TRM}
%     \end{subfigure}
%     \begin{subfigure}[b]{0.3\textwidth}
%         \includegraphics[width=\textwidth]{TRM_Pontoise}
%     \end{subfigure}
% \caption{Truites de mer observées en vidéocomptage à Poses (à gauche) et à Pontoise (à droite).}
% \label{TRM}
% \end{figure}
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=0.8\textwidth]{plot_annuel_trm}
% \caption{Effectifs journaliers des truites de mer observés sur les STACOMI du bassin Seine en \Sexpr{annee}.}
% \label{plot_annuel_trm}
% \end{figure}
% 
% La population de truite de mer est historiquement plus abondante que celle du saumon sur le fleuve, ce qui explique des observations plus fréquentes sur les stations en amont, notamment à Carandeau et, plus récemment, à Pontoise (Figure \ref{plot_historique_trm}).
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=\textwidth]{plot_historique_trm}
% \caption{Evolution interannuelle des effectifs des truites de mer en montaison sur les STACOMI du bassin de la Seine. Les axes des ordonnées n'ont pas la même échelle. Début des comptages : Poses rive gauche en 2008, Poses rive droite et Carandeau en 2018, Pontoise en 2023.}
% \label{plot_historique_trm}
% \end{figure}
% 
% Au niveau de la phénologie de la migration et comme chez le saumon, on observe une prédominance croissante de la vague printanière (Figure \ref{p_seasonal_trm}).
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=0.8\textwidth]{p_seasonal_trm}
% \caption{Rythmes migratoires des truites de mer au barrage de Poses - Amfreville-sous-les-Monts.}
% \label{p_seasonal_trm}
% \end{figure}
% 
% Comprise entre \Sexpr{round(min(subset(data_taille_trm,annee==selected_annee)$car_valeur_quantitatif))} et \Sexpr{round(max(subset(data_taille_sat,annee==selected_annee)$car_valeur_quantitatif))} mm, la taille moyenne de la population atteint \Sexpr{round(mean(subset(data_taille_sat,annee==selected_annee)$car_valeur_quantitatif))} mm (Figure \ref{Taille_TRM}).
% 
% Chez la truite de mer, la lecture des écailles (scalimétrie) permet de classer les individus en plusieurs catégories :
% 
% - les finnocks, jeunes individus ayant passé 4 à 6 mois en mer, atteignent rarement 430 mm ;
% 
% - les truites ayant passé un hiver en mer mesurent entre 430 mm et 590 mm ;
% 
% - les individus ayant passé au moins deux hivers en mer peuvent atteindre, voire dépasser, 900 mm. Comme pour le saumon, ces grands individus sont de moins en moins observés sur les stations de comptage.
% 
% \begin{figure}[htpb]
%     \centering
%       \begin{subfigure}[b]{0.48\textwidth}
%           \includegraphics[width=\textwidth]{plot_histo_taille_trm}
%       \end{subfigure}
%       \begin{subfigure}[b]{0.48\textwidth}
%           \includegraphics[width=\textwidth]{plot_age_mer_trm}
%       \end{subfigure}
%   \caption{Représentation des tailles et des âges de mer des truites de mer observées en vidéocomptage au barrage de Poses - Amfreville-sous-les-Monts. Les tailles historiques sont présentées en transparence sur le graphique de gauche.}
%   \label{Taille_TRM}
% \end{figure}
% 
% La migration des truites de mer est majoritairement diurne (Figure \ref{p_horaires_trm}).
% 
% \begin{figure}[htpb]
% \centering
% \includegraphics[width=\textwidth,height=0.3\textheight,keepaspectratio]{p_horaires_trm}
% \caption{Horaires de migration des truites de mer en \Sexpr{annee}}
% \label{p_horaires_trm}
% \end{figure}


\clearpage

\subsection{Autres espèces}

<<chunk bil esp,echo=FALSE, eval=FALSE,results='hide'>>=

tax_ref<-data.frame(tax_nom_latin=c("Abramis brama", "Alburnus alburnus", "Aspius aspius", "Barbus barbus", "Carassius",
                                    "Chondrostoma nasus", "Ctenopharyngodon idellus", "Cyprinidae", "Cyprinus carpio",
                                    "Esox lucius", "Leuciscus cephalus", "Leuciscus idus", "Perca fluviatilis", "Rutilus rutilus",
                                    "Salmo trutta fario", "Sander lucioperca", "Scardinius erythrophthalmus", "Silurus glanis",
                                    "Tinca tinca", "Chelon ramada", "Acipenser", "Eriocheir sinensis", "Lepomis gibbosus",
                                    "Neogobius melanostomus", "Ameiurus melas", "Gobio gobio", "Lampetra", "Leuciscus leuciscus",
                                    "Oncorhynchus mykiss","Taxon inconnu"),
                      tax_commun=c("Brème commune","Ablette","Aspe","Barbeau fluviatile","Carassin commun","Hotu","Amour blanc","Cyprinidé indéterminé",
                                   "Carpe commune","Brochet","Chevesne","Ide mélanote","Perche","Gardon","Truite fario","Sandre","Rotengle","Silure glane","Tanche","Mulet porc","Esturgeon exotique indéterminé","Crabe chinois","Perche soleil","Gobie à tâches noires","Poisson-chat","Goujon",
                                   "Lamproie indéterminée","Vandoise","Truite arc-en-ciel","Taxon indéterminé"))

bilesp_poses_vc_rd$station <- "Poses"
bilesp_poses_vc_rg$station <- "Poses"
bilesp_pontoise$station <- "Pontoise"
bilesp_carandeau$station <- "Carandeau"
bilesp_tot<-rbind(bilesp_poses_vc_rd,bilesp_poses_vc_rg,bilesp_pontoise,bilesp_carandeau)
bilesp_tot <- bilesp_tot %>% filter(!tax_nom_latin %in% c
                                    ("Alosa","Anguilla anguilla","Lampetra fluviatilis",
                                     "Petromyzon marinus","Chelon ramada","Salmo salar","Salmo trutta trutta")) %>%
                              group_by(tax_nom_latin,station) %>%
                              summarise(effectifs=sum(abs(lot_effectif)))
bilesp_tot<-right_join(tax_ref,bilesp_tot,by="tax_nom_latin") 
bilesp_poses <- bilesp_tot %>% filter(station == "Poses") %>%
                select(-tax_nom_latin) %>%
                rename(Poses=effectifs) %>%
                select(-station)

bilesp_pontoise <- bilesp_tot %>% filter(station == "Pontoise") %>%
                select(-tax_nom_latin) %>%
                rename(Pontoise=effectifs) %>%
                select(-station)

bilesp_carandeau <- bilesp_tot %>% filter(station == "Carandeau") %>%
                select(-tax_nom_latin) %>%
                rename(Carandeau=effectifs) %>%
                select(-station)

bilesp_all <- bilesp_poses %>% full_join(bilesp_pontoise, by="tax_commun") %>%
              full_join(bilesp_carandeau, by="tax_commun") %>% 
              rename(Espèces = tax_commun) %>%
              arrange(Espèces) 

bilesp_all_fmt <- bilesp_all %>%
  mutate(across(c(Poses, Pontoise, Carandeau),
                ~ ifelse(is.na(.), NA_character_,
                         scales::number(., big_mark = " ", decimal_mark = ","))))
options(knitr.kable.NA = "")

bilesp_all_latex <- bilesp_all_fmt %>%
  kbl(
    caption = "Effectifs annuels des poissons holobiotiques comptabilisés sur les stations de contrôle des migrations du bassin de la Seine",
    booktabs = TRUE,
    format = "latex",
    escape = FALSE,
    linesep = "",
    label = "recap_holobiotique",
    na = ""
  )  %>%
  kable_styling(
    latex_options = c("striped","hold_position", "scale_down"),
    position = "center",
    full_width = FALSE)   %>%
  column_spec(1, width = "4cm") %>%
  column_spec(2, latex_column_spec = "C{2cm}", bold = F) %>%
  column_spec(3, latex_column_spec = "C{2cm}", bold = F) %>%
  column_spec(4, latex_column_spec = "C{2cm}", bold = F)

writeLines(bilesp_all_latex, str_c(tabwd, "recap_holobiotique.tex"))

@

% Hormis les grands poissons migrateurs, d'autres espèces empruntent les passes à poissons du barrage de Poses, de Pontoise et de Carandeau (Tableau \ref{tab:recap_holobiotique}). L'effectif correspond au nombre de fois où l'espèce a été observée par les caméras, que ce soit en montaison ou en dévalaison. Un effectif égal à zéro indique un poisson observé mais dont le sens de déplacement n’a pas pu être déterminé (apparition ou disparition du poisson au cours de la séquence vidéo).
% 
% \input{table/recap_holobiotique.tex}
% 
% \clearpage

\section{Suivi et fonctionnement technique des dispositifs de contrôle}

